---
import type { LocalContent } from "../data/sharjahContent";

interface Props {
  content: LocalContent;
}

const { content } = Astro.props;
---

<section class="bg-white px-5 py-16 sm:px-8 lg:px-12">
  <div class="mx-auto max-w-5xl">
    <h2 data-animate class="text-3xl font-black leading-tight text-slate-900 sm:text-4xl">
      {content.sectionTitle}
    </h2>

    <div data-animate data-animate-delay="1" class="mt-6 space-y-5">
      {
        content.intro.map((paragraph) => (
          <p class="text-base font-semibold leading-8 text-slate-600">{paragraph}</p>
        ))
      }
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {
        content.highlights.map((item, index) => (
          <div
            data-animate
            data-animate-delay={String(Math.min(index + 2, 5))}
            class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-6"
          >
            <h3 class="text-base font-black text-slate-900">{item.title}</h3>
            <p class="mt-3 text-sm font-semibold leading-7 text-slate-600">{item.text}</p>
          </div>
        ))
      }
    </div>

    <p data-animate class="mt-10 text-sm font-bold leading-7 text-slate-500">
      {content.closing}
    </p>
  </div>
</section>
